          <span class="footer-licensing-badge">ALOA Certified</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- Modal -->
  <div class="modal-backdrop" id="emergency-modal" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true">
      <div class="modal-header">
        <div class="modal-title"><span class="emergency-dot"></span><span>Emergency Locksmith Dispatch</span></div>
        <button type="button" class="modal-close-btn js-modal-close" aria-label="Close"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <div class="modal-body">
        <form id="emergency-dispatch-form">
          <div class="form-group"><label for="modal-phone" class="form-label">Phone Number (Required for Technician):</label><input type="tel" id="modal-phone" name="phone" class="form-control" placeholder="Your Phone Number" required></div>
          <div class="grid grid-2 gap-3 mb-3">
            <div class="form-group"><label for="modal-name" class="form-label">Your Name:</label><input type="text" id="modal-name" name="name" class="form-control" placeholder="Jane Doe" required></div>
            <div class="form-group"><label for="modal-service-type" class="form-label">Service Type:</label><select id="modal-service-type" name="service_type" class="form-select"><option value="residential-lockout">House / Apartment Lockout</option><option value="car-lockout">Car / Vehicle Lockout</option><option value="broken-key">Broken Key Extraction</option><option value="urgent-rekey">Urgent Lock Rekey</option><option value="commercial">Commercial Building Lock</option><option value="key-duplication">Key Duplication</option></select></div>
          </div>
          <div class="form-group"><label for="modal-location" class="form-label">Location / Address:</label><input type="text" id="modal-location" name="location" class="form-control" placeholder="Street Address, City or Landmark" required></div>
          <div class="form-group"><label for="modal-notes" class="form-label">Situation Notes:</label><textarea id="modal-notes" name="notes" class="form-textarea" placeholder="Describe the lock or situation" rows="2"></textarea></div>
          <button type="submit" class="btn btn-emergency btn-block mt-3">Dispatch Emergency Van</button>
        </form>
      </div>
    </div>
  </div>

  <aside class="floating-emergency-bar">
    <button type="button" class="back-to-top-btn" aria-label="Back to top"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg></button>
  </aside>

  <nav class="mobile-bottom-bar">
    <a href="contact.html" class="btn btn-emergency btn-sm">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      Emergency Service
    </a>
    <button type="button" class="btn btn-primary btn-sm js-open-emergency-modal">Request Locksmith</button>
  </nav>

