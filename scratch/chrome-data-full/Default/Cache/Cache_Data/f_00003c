/* ==========================================================================
   AegisLock 24/7 - Components Stylesheet
   Headers, Navbars, Buttons, Cards, Modals, Forms, Footers, and Interactive Widgets
   ========================================================================== */

/* ==========================================================================
   1. Top Emergency Alert Bar
   ========================================================================== */
.top-bar {
  background-color: var(--strip-bg);
  border-bottom: 1px solid var(--border-subtle);
  font-size: 0.85rem;
  padding-block: 0.5rem;
  transition: background-color var(--transition-base), border-color var(--transition-base);
}

.top-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.top-bar-status {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.top-bar-highlight {
  color: var(--amber-500);
  font-weight: 600;
}

.top-bar-actions {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

.top-bar-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.top-bar-link:hover {
  color: var(--amber-500);
}

.top-bar-phone {
  color: var(--emergency-500);
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.top-bar-phone:hover {
  color: var(--emergency-400);
}

/* ==========================================================================
   2. Main Navigation Header
   ========================================================================== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: var(--bg-glass);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--header-border);
  transition: all var(--transition-base);
}

.site-header.is-scrolled {
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.25);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 4.75rem;
  gap: 1.5rem;
}

/* Brand Logo */
.brand-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
}

.brand-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--amber-500), var(--amber-700));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  box-shadow: 0 4px 12px var(--amber-glow);
  flex-shrink: 0;
}

.brand-icon svg {
  width: 24px;
  height: 24px;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: var(--font-heading);
  font-size: 1.45rem;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.1;
  letter-spacing: -0.03em;
}

.brand-name span {
  color: var(--amber-500);
}

.brand-tagline {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* Nav Links */
.nav-menu {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-inline: auto;
  gap: 0.65rem;
}

.nav-item {
  position: relative;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.55rem 0.95rem;
  font-family: var(--font-heading);
  font-size: 0.925rem;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.nav-link:hover,
.nav-link.active {
  color: var(--amber-500);
  background: var(--amber-soft);
}

/* Nav Dropdown */
.nav-dropdown {
  position: absolute;
  top: 100%;
  inset-inline-start: 0;
  min-width: 220px;
  background: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-xl);
  padding: 0.5rem;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all var(--transition-fast);
  z-index: 100;
}

.nav-item:hover .nav-dropdown,
.nav-item:focus-within .nav-dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dropdown-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 0.85rem;
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-secondary);
  transition: all var(--transition-fast);
}

.dropdown-link:hover,
.dropdown-link.active {
  color: var(--amber-500);
  background: var(--amber-soft);
  padding-inline-start: 1rem;
}

.dropdown-badge {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  background: var(--amber-500);
  color: #000000;
  padding: 0.15rem 0.4rem;
  border-radius: 4px;
}

/* Header Utilities (Theme, RTL, Emergency CTA) */
.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.control-btn {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
  font-weight: 600;
  font-size: 0.85rem;
}

.control-btn:hover {
  color: var(--amber-500);
  border-color: var(--amber-500);
  background: var(--amber-soft);
}

.control-btn svg {
  width: 20px;
  height: 20px;
}

/* Mobile Toggle */
.mobile-nav-toggle {
  display: none;
  width: 42px;
  height: 42px;
  border-radius: var(--radius-md);
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  color: var(--text-main);
  align-items: center;
  justify-content: center;
}

.mobile-nav-toggle svg {
  width: 24px;
  height: 24px;
}

/* ==========================================================================
   3. Buttons & CTAs
   ========================================================================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 700;
  padding: 0.75rem 1.45rem;
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
  text-align: center;
  white-space: nowrap;
  user-select: none;
  border: 1px solid transparent;
}

.btn svg {
  width: 19px;
  height: 19px;
  flex-shrink: 0;
  transition: transform var(--transition-fast);
}

.btn:hover svg {
  transform: translateX(3px);
}

[dir="rtl"] .btn:hover svg {
  transform: translateX(-3px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--amber-500), var(--amber-600));
  color: #0d121d;
  box-shadow: 0 4px 14px var(--amber-glow);
}

.btn-primary:hover {
  background: linear-gradient(135deg, var(--amber-400), var(--amber-500));
  transform: translateY(-2px);
  box-shadow: 0 6px 20px var(--amber-glow);
  color: #000000;
}

.btn-emergency {
  background: linear-gradient(135deg, var(--emergency-500), var(--emergency-600));
  color: #ffffff;
  box-shadow: 0 4px 16px var(--emergency-glow);
  position: relative;
  overflow: hidden;
}

.btn-emergency:hover {
  background: linear-gradient(135deg, var(--emergency-400), var(--emergency-500));
  transform: translateY(-2px);
  box-shadow: 0 8px 24px var(--emergency-glow);
  color: #ffffff;
}

.btn-emergency-pulse::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
  animation: pulse-ring 2s infinite cubic-bezier(0.66, 0, 0, 1);
  pointer-events: none;
}

.btn-outline {
  background: transparent;
  border-color: var(--border-hover);
  color: var(--text-main);
}

.btn-outline:hover {
  background: var(--bg-card-hover);
  border-color: var(--amber-500);
  color: var(--amber-500);
  transform: translateY(-2px);
}

.btn-outline-amber {
  background: var(--amber-soft);
  border-color: var(--amber-500);
  color: var(--amber-500);
}

.btn-outline-amber:hover {
  background: var(--amber-500);
  color: #0d121d;
  box-shadow: 0 4px 14px var(--amber-glow);
}

.btn-secondary {
  background: var(--bg-card);
  border-color: var(--border-card);
  color: var(--text-main);
}

.btn-secondary:hover {
  background: var(--bg-card-hover);
  border-color: var(--border-hover);
  color: var(--text-main);
}

.btn-sm {
  padding: 0.45rem 0.95rem;
  font-size: 0.85rem;
  border-radius: var(--radius-sm);
}

.btn-lg {
  padding: 0.95rem 1.9rem;
  font-size: 1.05rem;
  border-radius: var(--radius-lg);
}

.btn-block {
  width: 100%;
}

/* ==========================================================================
   4. Cards
   ========================================================================== */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  padding: 1.75rem;
  transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  position: relative;
}

.card:hover {
  border-color: var(--border-hover);
  box-shadow: var(--shadow-card);
  transform: translateY(-3px);
}

/* Service Card */
.service-card {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all var(--transition-base);
}

.service-card:hover {
  border-color: var(--amber-500);
  box-shadow: 0 12px 30px -5px rgba(0, 0, 0, 0.4);
  transform: translateY(-4px);
}

.service-card-media {
  position: relative;
  height: 200px;
  overflow: hidden;
}

.service-card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-smooth);
}

.service-card:hover .service-card-media img {
  transform: scale(1.06);
}

.service-card-badge {
  position: absolute;
  top: 1rem;
  inset-inline-start: 1rem;
  background: rgba(10, 13, 20, 0.85);
  backdrop-filter: blur(8px);
  border: 1px solid var(--border-accent);
  color: var(--amber-400);
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.3rem 0.65rem;
  border-radius: var(--radius-sm);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.service-card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.service-card-title {
  font-size: 1.25rem;
  margin-bottom: 0.6rem;
  color: var(--text-main);
}

.service-card-desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin-bottom: 1.25rem;
  flex-grow: 1;
}

.service-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 1rem;
  border-top: 1px solid var(--border-subtle);
  margin-top: auto;
}

.service-price {
  display: flex;
  flex-direction: column;
}

.service-price-label {
  font-size: 0.72rem;
  text-transform: uppercase;
  color: var(--text-muted);
  font-weight: 600;
}

.service-price-val {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--amber-500);
}

/* Feature Card */
.feature-card {
  padding: 2rem;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  transition: all var(--transition-base);
}

.feature-card:hover {
  border-color: var(--amber-500);
  transform: translateY(-4px);
  box-shadow: var(--shadow-card);
}

.feature-icon-wrapper {
  width: 58px;
  height: 58px;
  border-radius: var(--radius-md);
  background: var(--amber-soft);
  border: 1px solid var(--badge-border);
  color: var(--amber-500);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.35rem;
}

.feature-icon-wrapper svg {
  width: 28px;
  height: 28px;
}

.feature-title {
  font-size: 1.2rem;
  margin-bottom: 0.65rem;
}

.feature-desc {
  font-size: 0.92rem;
  color: var(--text-secondary);
}

/* Testimonial Card */
.testimonial-card {
  padding: 2rem;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.stars-rating {
  display: flex;
  gap: 0.25rem;
  color: var(--amber-500);
  margin-bottom: 1rem;
}

.stars-rating svg {
  width: 17px;
  height: 17px;
  fill: currentColor;
}

.testimonial-text {
  font-size: 0.95rem;
  font-style: italic;
  color: var(--text-main);
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.testimonial-author {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-subtle);
}

.author-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--amber-500);
}

.author-info {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--text-main);
}

.author-tag {
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* ==========================================================================
   Team Card Component (About Page)
   ========================================================================== */
.team-card {
  display: flex;
  flex-direction: column;
  padding: 1.5rem;
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  transition: all var(--transition-base);
  height: 100%;
  text-align: center;
}

.team-card:hover {
  border-color: var(--amber-500);
  transform: translateY(-4px);
  box-shadow: var(--shadow-card);
}

.team-card-media {
  position: relative;
  width: 100%;
  height: 240px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 1.25rem;
  border: 1px solid var(--border-card);
  background: var(--bg-surface);
}

.team-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  transition: transform var(--transition-smooth);
}

.team-card:hover .team-card-img {
  transform: scale(1.05);
}

.team-card-body {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  text-align: center;
}

.team-card-name {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0.25rem;
}

.team-card-role {
  font-size: 0.825rem;
  font-weight: 600;
  color: var(--amber-500);
  display: block;
  margin-bottom: 0.85rem;
}

.team-card-desc {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 1.25rem;
  flex-grow: 1;
}

.team-card-footer {
  margin-top: auto;
  display: flex;
  justify-content: center;
}

/* About Heritage Media */
.about-heritage-media {
  position: relative;
  width: 100%;
  height: 300px;
  overflow: hidden;
  border-radius: var(--radius-xl);
  border: 1px solid var(--border-card);
  background: var(--bg-surface);
}

.about-heritage-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* About Stats Strip */
.about-stats-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
  padding: 1.35rem 1.5rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-xl);
  margin-top: 1.5rem;
  margin-bottom: 2.25rem;
  text-align: center;
  box-sizing: border-box;
}

.about-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 2rem;
  margin-bottom: 0.5rem;
}

@media (max-width: 640px) {
  .about-stats-strip {
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1.25rem 1rem;
  }
  .about-stats-strip .border-inline-start {
    border-inline-start: none;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.75rem;
  }
  .about-actions {
    flex-direction: column;
    align-items: stretch;
  }
  .about-actions .btn {
    width: 100%;
    text-align: center;
    justify-content: center;
  }
}

/* ==========================================================================
   Featured Blog Card
   ========================================================================== */
.featured-blog-card {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  padding: 2rem;
  box-shadow: var(--shadow-xl);
  overflow: hidden;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.featured-blog-card:hover {
  border-color: var(--border-hover);
  box-shadow: var(--shadow-card);
}

.featured-blog-grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  align-items: center;
  gap: 2.5rem;
}

.featured-blog-media {
  position: relative;
  width: 100%;
  height: 320px;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-surface);
}

.featured-blog-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-smooth);
}

.featured-blog-card:hover .featured-blog-media img {
  transform: scale(1.03);
}

.featured-blog-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.featured-blog-title {
  font-size: clamp(1.4rem, 2vw + 0.5rem, 1.85rem);
  font-weight: 700;
  margin-bottom: 0.75rem;
  line-height: 1.3;
}

.featured-blog-desc {
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.featured-blog-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  padding-top: 1.25rem;
  border-top: 1px solid var(--border-subtle);
  margin-top: auto;
}

/* ==========================================================================
   Filter Toolbars & Search Controls (Blog & Services Listing)
   ========================================================================== */
.filter-toolbar-section {
  padding-block: 2.25rem;
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--border-subtle);
  position: relative;
  z-index: 5;
}

@media (max-width: 768px) {
  .filter-toolbar-section {
    padding-block: 1.5rem;
  }
}

.blog-filter-toolbar,
.services-filter-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
}

@media (min-width: 1024px) {
  .blog-filter-toolbar,
  .services-filter-toolbar {
    flex-wrap: nowrap;
    gap: 1.5rem;
  }

  .blog-filter-search,
  .service-filter-search {
    max-width: 300px;
    width: 300px;
    flex-shrink: 0;
  }

  .blog-filter-categories,
  .services-filter-categories {
    flex: 1;
    min-width: 0;
    justify-content: flex-end;
    overflow-x: auto;
  }
}

@media (max-width: 1023px) {
  .blog-filter-toolbar,
  .services-filter-toolbar {
    flex-direction: column;
    align-items: stretch;
    gap: 1.25rem;
  }

  .blog-filter-search,
  .service-filter-search {
    max-width: 100%;
    width: 100%;
  }

  .blog-filter-categories,
  .services-filter-categories {
    justify-content: flex-start;
    overflow-x: auto;
    padding-bottom: 0.35rem;
    width: 100%;
  }
}

.blog-filter-search,
.service-filter-search {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
}

.search-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  width: 100%;
}

.search-input-icon {
  position: absolute;
  inset-inline-start: 0.85rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  pointer-events: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.search-input-wrap .form-control {
  padding-inline-start: 2.4rem;
  padding-inline-end: 2.25rem;
  width: 100%;
  height: 2.625rem;
  font-size: 0.875rem;
  box-sizing: border-box;
}

.blog-filter-search .btn,
.service-filter-search .btn {
  height: 2.625rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  flex-shrink: 0;
  white-space: nowrap;
  box-sizing: border-box;
}

.search-clear-btn {
  position: absolute;
  inset-inline-end: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 0.25rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
