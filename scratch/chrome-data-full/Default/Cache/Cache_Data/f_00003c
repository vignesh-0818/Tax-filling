  overflow: hidden;
  margin-bottom: 1.15rem;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
}

.related-article-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-smooth);
}

.related-article-card:hover .related-article-img {
  transform: scale(1.05);
}

.related-article-category {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--amber-500);
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  display: block;
}

.related-article-title {
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 0.75rem;
  color: var(--text-main);
  overflow-wrap: break-word;
}

.related-article-title a {
  color: var(--text-main);
  text-decoration: none;
  transition: color var(--transition-fast);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.related-article-title a:hover {
  color: var(--amber-500);
}

.related-article-desc {
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: 1.25rem;
  overflow-wrap: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex-grow: 1;
}

.related-article-link {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--amber-500);
  text-decoration: none;
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  transition: gap var(--transition-fast);
}

.related-article-link:hover {
  gap: 0.6rem;
  color: var(--amber-400);
}

/* Pricing Card */
.pricing-card {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-xl);
  padding: 2.25rem;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all var(--transition-base);
}

.pricing-card.is-popular {
  border-color: var(--amber-500);
  box-shadow: 0 10px 30px -5px var(--amber-glow);
  transform: scale(1.02);
}

.popular-badge {
  position: absolute;
  top: -12px;
  inset-inline-start: 50%;
  transform: translateX(-50%);
  background: var(--amber-500);
  color: #000000;
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.25rem 0.85rem;
  border-radius: var(--radius-full);
}

.pricing-header {
  margin-bottom: 1.75rem;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.pricing-title {
  font-size: 1.35rem;
  margin-bottom: 0.5rem;
  min-height: 2.2rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pricing-desc {
  font-size: 0.875rem;
  color: var(--text-secondary);
  min-height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pricing-price-box {
  margin-block: 1.25rem;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 0.25rem;
}

.pricing-currency {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--amber-500);
}

.pricing-amount {
  font-family: var(--font-heading);
  font-size: 3rem;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1;
}

.pricing-frequency {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.pricing-features-list {
  margin-bottom: 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex-grow: 1;
}

.pricing-feature-item {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.pricing-feature-item svg {
  width: 18px;
  height: 18px;
  color: var(--amber-500);
  flex-shrink: 0;
}

/* Itemized Service Breakdown Cards */
.pricing-detail-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.pricing-table-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
  padding-bottom: 0.85rem;
  margin-bottom: 1.25rem;
  border-bottom: 1px solid var(--border-subtle);
  min-height: 2.75rem;
}

.pricing-table-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 0;
  line-height: 1.3;
  flex: 1 1 auto;
}

.pricing-table-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap !important;
  flex-shrink: 0;
  font-family: var(--font-mono, monospace);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--color-amber);
  background: var(--amber-soft);
  border: 1px solid rgba(245, 158, 11, 0.35);
  border-radius: var(--radius-full);
  padding: 0.32rem 0.85rem;
  line-height: 1;
}

.pricing-rows-list {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  gap: 0;
}

.pricing-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
  padding-block: 0.75rem;
  border-bottom: 1px solid var(--border-subtle);
  font-size: 0.875rem;
}

.pricing-row:last-child {
  border-bottom: none;
}

.pricing-service-name {
  color: var(--text-secondary);
  line-height: 1.45;
  flex: 1 1 auto;
}

.pricing-service-price {
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--text-main);
  white-space: nowrap;
  flex-shrink: 0;
  text-align: right;
  margin-inline-start: auto;
}

@media (max-width: 576px) {
  .pricing-table-header {
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: auto;
  }
}

/* ==========================================================================
   5. Interactive Widgets: Estimator, Tabs, Accordions, Checker
   ========================================================================== */

/* Tabs */
.tabs-nav {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 0.5rem;
  margin-bottom: 2rem;
  overflow-x: auto;
}

.tab-btn {
  padding: 0.6rem 1.25rem;
  font-family: var(--font-heading);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.tab-btn:hover {
  color: var(--text-main);
  background: var(--bg-card);
}

.tab-btn.active {
  color: var(--amber-500);
  background: var(--amber-soft);
  border: 1px solid var(--badge-border);
}

.tab-content-panel {
  display: none;
}

.tab-content-panel.active {
  display: block;
}

/* Accordions */
.accordion {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  margin-bottom: 3rem;
  width: 100%;
  box-sizing: border-box;
}

.accordion-item {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: border-color var(--transition-fast), background-color var(--transition-fast);
  box-sizing: border-box;
  width: 100%;
}

.accordion-item.open {
  border-color: rgba(245, 158, 11, 0.45);
  background: var(--bg-surface);
}

.accordion-header {
  width: 100%;
  padding: 1.15rem 1.35rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  text-align: start;
  font-family: var(--font-heading);
  font-size: 1.025rem;
  font-weight: 700;
  color: var(--text-main);
  background: transparent;
  border: none;
  cursor: pointer;
  box-sizing: border-box;
  transition: color var(--transition-fast);
}

.accordion-header:hover {
  color: var(--amber-500);
}

.accordion-item.open .accordion-header {
  color: var(--amber-500);
  border-bottom: 1px solid var(--border-subtle);
}

.accordion-icon {
  width: 20px;
  height: 20px;
  color: var(--text-secondary);
  transition: transform var(--transition-base);
  flex-shrink: 0;
}

.accordion-item.open .accordion-icon {
  transform: rotate(180deg);
  color: var(--amber-500);
}

.accordion-body {
  padding: 1.15rem 1.35rem;
  font-size: 0.925rem;
  color: var(--text-secondary);
  line-height: 1.65;
  display: none;
  box-sizing: border-box;
  overflow-wrap: break-word;
  word-break: normal;
}

.accordion-body p {
  margin: 0;
  color: var(--text-secondary);
}

.accordion-item.open .accordion-body {
  display: block;
}

/* Locksmith Cost Estimator Box */
.estimator-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-xl);
  padding: 2.25rem;
  box-shadow: var(--shadow-xl);
}

.estimator-output-panel {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.estimator-price-tag {
  font-family: var(--font-heading);
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--amber-500);
  margin-block: 0.5rem;
}

/* Zip Coverage Checker Widget */
.zip-checker-box {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-xl);
  padding: 2rem;
}

.zip-input-group {
  display: flex;
  gap: 0.75rem;
}

@media (max-width: 600px) {
  .zip-input-group {
    flex-direction: column;
  }
}

/* ==========================================================================
   6. Forms & Controls
   ========================================================================== */
.form-group {
  margin-bottom: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-label {
  font-family: var(--font-heading);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-main);
}

.form-control,
.form-select,
.form-textarea {
  width: 100%;
  background: var(--bg-input);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 0.75rem 1rem;
  font-size: 0.95rem;
  color: var(--text-main);
  transition: all var(--transition-fast);
}

.form-control:focus,
.form-select:focus,
.form-textarea:focus {
  outline: none;
  border-color: var(--amber-500);
  box-shadow: 0 0 0 3px var(--amber-glow);
}

.form-textarea {
  min-height: 120px;
  resize: vertical;
}

.form-feedback {
  font-size: 0.8rem;
  margin-top: 0.25rem;
  display: none;
}

.form-group.has-error .form-control {
  border-color: var(--emergency-500);
}

.form-group.has-error .form-feedback {
  display: block;
  color: var(--emergency-500);
}

/* ==========================================================================
   7. Modals
   ========================================================================== */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5, 8, 13, 0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.25rem;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-base);
}

.modal-backdrop.open {
  opacity: 1;
  visibility: visible;
}

.modal-dialog {
  width: 100%;
  max-width: 580px;
  background: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-xl);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
  transform: translateY(20px) scale(0.96);
  transition: transform var(--transition-smooth);
  overflow: hidden;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
}

.modal-backdrop.open .modal-dialog {
  transform: translateY(0) scale(1);
}

.modal-header {
  padding: 1.5rem;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.modal-title {
  font-size: 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.modal-close-btn {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}

.modal-close-btn:hover {
  background: var(--bg-card);
  color: var(--text-main);
}

.modal-body {
  padding: 1.5rem;
  overflow-y: auto;
}

/* ==========================================================================
   8. Mobile Off-Canvas Menu
   ========================================================================== */
.mobile-nav-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(4px);
  z-index: 1500;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-base);
}

.mobile-nav-backdrop.open {
  opacity: 1;
  visibility: visible;
}

.mobile-nav-drawer {
  position: fixed;
  top: 0;
  inset-inline-end: 0;
  width: 85%;
  max-width: 380px;
  height: 100%;
  background: var(--bg-surface);
  border-inline-start: 1px solid var(--border-card);
  z-index: 1600;
  transform: translateX(100%);
  transition: transform var(--transition-smooth);
  display: flex;
  flex-direction: column;
  padding: 1.5rem;
  overflow-y: auto;
}

[dir="rtl"] .mobile-nav-drawer {
  transform: translateX(-100%);
}

.mobile-nav-backdrop.open .mobile-nav-drawer {
  transform: translateX(0);
}

.mobile-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border-subtle);
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 2rem;
}

.mobile-nav-link {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 0.75rem 1rem;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mobile-nav-link:hover,
.mobile-nav-link.active {
  color: var(--amber-500);
  background: var(--amber-soft);
}

/* ==========================================================================
   9. Floating Emergency Action Bar
   ========================================================================== */
.floating-emergency-bar {
  position: fixed;
  bottom: 1.5rem;
  inset-inline-end: 1.5rem;
  z-index: 900;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.floating-dial-btn {
  background: linear-gradient(135deg, var(--emergency-500), var(--emergency-600));
  color: #ffffff;
  padding: 0.85rem 1.35rem;
  border-radius: var(--radius-full);
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 700;
  box-shadow: 0 8px 24px var(--emergency-glow);
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  position: relative;
  transition: transform var(--transition-fast);
}

.floating-dial-btn:hover {
  transform: scale(1.05);
  color: #ffffff;
}

.back-to-top-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-fast);
}

.back-to-top-btn.visible {
  opacity: 1;
  visibility: visible;
}

.back-to-top-btn:hover {
  color: var(--amber-500);
  border-color: var(--amber-500);
}

/* ==========================================================================
   10. Toast Notifications
   ========================================================================== */
.toast-container {
  position: fixed;
  top: 1.5rem;
  inset-inline-end: 1.5rem;
  z-index: 2500;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  pointer-events: none;
}

.toast {
  background: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-inline-start: 4px solid var(--amber-500);
  border-radius: var(--radius-md);
  padding: 1rem 1.25rem;
  box-shadow: var(--shadow-xl);
  color: var(--text-main);
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  min-width: 300px;
  max-width: 420px;
  pointer-events: auto;
  transform: translateX(100%);
  animation: slideInToast 0.35s forwards cubic-bezier(0.16, 1, 0.3, 1);
}

[dir="rtl"] .toast {
  transform: translateX(-100%);
}

.toast.toast-success {
  border-inline-start-color: var(--success-green);
}

.toast.toast-emergency {
  border-inline-start-color: var(--emergency-500);
}

@keyframes slideInToast {
  to { transform: translateX(0); }
}

/* ==========================================================================
   11. Footer
   ========================================================================== */
.site-footer {
  background: var(--footer-bg);
  border-top: 1px solid var(--border-subtle);
  padding-top: 4.5rem;
  color: var(--text-secondary);
  font-size: 0.925rem;
}

.footer-top {
  padding-bottom: 3.5rem;
  border-bottom: 1px solid var(--border-subtle);
}

.footer-brand-col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.footer-desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.footer-emergency-callout {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  padding: 0.85rem 1.25rem;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 0.5rem;
}

.footer-emergency-text {
  display: flex;
  flex-direction: column;
}

.footer-emergency-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--emergency-400);
}

.footer-emergency-number {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 800;
  color: #ffffff;
}

.footer-heading {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 1.25rem;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.footer-link {
  color: var(--text-secondary);
  transition: all var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.footer-link:hover {
  color: var(--amber-500);
  transform: translateX(3px);
}

[dir="rtl"] .footer-link:hover {
  transform: translateX(-3px);
}

.footer-bottom {
  padding-block: 1.75rem;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}

.footer-licensing-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-sm);
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* ==========================================================================
   10. Inner Page Hero (consistent full-width image hero for all non-home pages)
   Layout: Centered Page Title ABOVE Centered Breadcrumb (matches reference image)
   ========================================================================== */
.inner-page-hero {
  position: relative;
  width: 100%;
  min-height: 280px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-block: 4.25rem;
  background-color: var(--bg-surface);
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  isolation: isolate;
  overflow: hidden;
}

/* Balanced dark overlay — keeps existing image clearly visible while title & breadcrumb stay ultra-readable */
.inner-page-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    180deg,
    rgba(10, 13, 20, 0.65) 0%,
    rgba(10, 13, 20, 0.52) 50%,
    rgba(10, 13, 20, 0.7) 100%
  );
}

.inner-page-hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

/* Hero Title — displayed ABOVE breadcrumb, bold white, centered */
.inner-page-hero-title {
  font-family: var(--font-heading);
  font-size: clamp(2.3rem, 4.8vw, 3.4rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.025em;
  color: #ffffff;
  margin: 0 0 0.85rem 0;
  text-shadow: 0 3px 18px rgba(0, 0, 0, 0.65);
}

/* Breadcrumb — displayed directly BELOW title, clean, centered */
.inner-hero-breadcrumb {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0;
}

.inner-hero-breadcrumb ol {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  list-style: none;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  font-size: 1rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
}

.inner-hero-breadcrumb ol li {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.inner-hero-breadcrumb a {
  color: rgba(255, 255, 255, 0.88);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.inner-hero-breadcrumb a:hover {
  color: var(--amber-400);
}

.inner-hero-breadcrumb .crumb-sep {
  color: rgba(255, 255, 255, 0.6);
  font-weight: 400;
  padding-inline: 0.15rem;
}

.inner-hero-breadcrumb .crumb-current {
  color: #ffffff;
  font-weight: 600;
}

@media (max-width: 768px) {
  .inner-page-hero {
    min-height: 230px;
    padding-block: 3.25rem;
  }
  .inner-page-hero-title {
    font-size: 2.1rem;
    margin-bottom: 0.65rem;
  }
  .inner-hero-breadcrumb ol {
    font-size: 0.9rem;
    gap: 0.45rem;
  }
}

@media (max-width: 480px) {
  .inner-page-hero {
    min-height: 200px;
    padding-block: 2.75rem;
  }
  .inner-page-hero-title {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }
  .inner-hero-breadcrumb ol {
    font-size: 0.84rem;
    gap: 0.4rem;
  }
}
