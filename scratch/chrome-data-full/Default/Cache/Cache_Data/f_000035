      <a href="blog-details.html?id=${rec.id}" class="recent-article-item">
        <div class="recent-article-thumb-wrap">
          <img src="${rec.image}" alt="${rec.title}" class="recent-article-thumb">
        </div>
        <div class="recent-article-info">
          <h4 class="recent-article-title">${rec.title}</h4>
          <span class="recent-article-date">${rec.date}</span>
        </div>
      </a>
    `).join('');
  }

  // Sidebar Search Widget Handler
  const sidebarSearchForm = document.getElementById('sidebar-search-form');
  const sidebarSearchInput = document.getElementById('sidebar-search-input');
  const sidebarSearchBtn = document.getElementById('sidebar-search-btn');

  function handleSidebarSearch(e) {
    if (e) e.preventDefault();
    const q = sidebarSearchInput ? sidebarSearchInput.value.trim() : '';
    if (q) {
      window.location.href = `blog.html?q=${encodeURIComponent(q)}`;
    } else if (sidebarSearchInput) {
      sidebarSearchInput.focus();
    }
  }

  if (sidebarSearchForm) {
    sidebarSearchForm.addEventListener('submit', handleSidebarSearch);
  }
  if (sidebarSearchBtn) {
    sidebarSearchBtn.addEventListener('click', handleSidebarSearch);
  }

  // Sidebar Categories Widget - dynamically populate counts and links matching BLOG_ARTICLES
  const categoriesList = document.getElementById('sidebar-categories-list');
  if (categoriesList && typeof BLOG_ARTICLES !== 'undefined') {
    const catMap = new Map();
    BLOG_ARTICLES.forEach(a => {
      const cat = a.category.trim();
      catMap.set(cat, (catMap.get(cat) || 0) + 1);
    });

    categoriesList.innerHTML = Array.from(catMap.entries()).map(([cat, count]) => `
      <li>
        <a href="blog.html?category=${encodeURIComponent(cat)}" class="blog-category-link">
          <span>${cat}</span>
          <span class="text-xs text-muted font-mono">(${count})</span>
        </a>
      </li>
    `).join('');
  }
}

window.copyArticleLink = function() {
  if (navigator.clipboard) {
    navigator.clipboard.writeText(window.location.href);
    showToast('Article link copied to clipboard!', 'success');
  } else {
    showToast('URL: ' + window.location.href, 'info');
  }
};

