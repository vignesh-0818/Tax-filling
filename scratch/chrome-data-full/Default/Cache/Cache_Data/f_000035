function initServiceListingFilter() {
  const searchInput = document.getElementById('service-search-input');
  const searchForm = document.getElementById('service-search-form');
  const searchClearBtn = document.getElementById('service-search-clear');
  const filterBtns = document.querySelectorAll('.js-service-filter-btn');
  const serviceCards = document.querySelectorAll('.js-service-item');
  const gridContainer = document.getElementById('services-grid-container');

  if (!serviceCards.length) return;

  // Create "No services found" message element if not present
  let noResultsEl = document.getElementById('services-no-results');
  if (!noResultsEl && gridContainer) {
    noResultsEl = document.createElement('div');
    noResultsEl.id = 'services-no-results';
    noResultsEl.className = 'card p-8 text-center col-span-full';
    noResultsEl.style.display = 'none';
    noResultsEl.style.gridColumn = '1 / -1';
    noResultsEl.innerHTML = `
      <div class="w-16 h-16 rounded-full bg-amber-soft text-amber mx-auto flex items-center justify-center mb-4">
        <svg width="30" height="30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
      <h3 class="text-xl font-bold mb-2">No Locksmith Services Found</h3>
      <p class="text-secondary text-sm mb-5 max-w-md mx-auto">No services matched your search query. Try searching for "rekey", "car key", "deadbolt", or "commercial".</p>
      <button type="button" id="service-reset-filter-btn" class="btn btn-outline-amber btn-sm">Reset Filters &amp; View All Services</button>
    `;
    gridContainer.appendChild(noResultsEl);

    document.getElementById('service-reset-filter-btn')?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (searchClearBtn) searchClearBtn.style.display = 'none';
      filterBtns.forEach(b => {
        if (b.getAttribute('data-filter') === 'all') {
          b.classList.add('active', 'btn-outline-amber');
          b.classList.remove('btn-secondary');
        } else {
          b.classList.remove('active', 'btn-outline-amber');
          b.classList.add('btn-secondary');
        }
      });
      filterServices();
      if (searchInput) searchInput.focus();
    });
  }

  function filterServices() {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    if (searchClearBtn) {
      searchClearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
    }

    const activeBtn = document.querySelector('.js-service-filter-btn.active');
    const category = activeBtn ? activeBtn.getAttribute('data-filter') : 'all';

    let visibleCount = 0;

    serviceCards.forEach(card => {
      const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
      const cardTitle = (card.querySelector('.service-card-title')?.textContent || '').toLowerCase();
      const cardDesc = (card.querySelector('.service-card-desc')?.textContent || '').toLowerCase();

      const matchesCat = category === 'all' || cardCategory.includes(category.toLowerCase());
      const matchesQuery = !query || cardTitle.includes(query) || cardDesc.includes(query) || cardCategory.includes(query);

      if (matchesCat && matchesQuery) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResultsEl) {
      noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterServices);
    searchInput.addEventListener('keyup', filterServices);
  }

  if (searchForm) {
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      filterServices();
    });
  }

  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchClearBtn.style.display = 'none';
      filterServices();
      if (searchInput) searchInput.focus();
    });
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'btn-outline-amber');
        b.classList.add('btn-secondary');
      });
      btn.classList.add('active', 'btn-outline-amber');
      btn.classList.remove('btn-secondary');
      filterServices();
    });
  });

  filterServices();
}

function initBlogListingFilter() {
  const searchInput = document.getElementById('blog-search-input');
  const searchForm = document.getElementById('blog-search-form');
  const searchBtn = document.getElementById('blog-search-btn');
  const searchClearBtn = document.getElementById('blog-search-clear');
  const filterBtns = document.querySelectorAll('.js-blog-filter-btn');
  const blogCards = document.querySelectorAll('.js-blog-item');
  const gridContainer = document.getElementById('blog-grid-container');

  if (!blogCards.length || !gridContainer) return;

  // Create "No articles found" element if not present
  let noResultsEl = document.getElementById('blog-no-results');
  if (!noResultsEl) {
    noResultsEl = document.createElement('div');
    noResultsEl.id = 'blog-no-results';
    noResultsEl.className = 'card p-8 text-center col-span-full';
    noResultsEl.style.display = 'none';
    noResultsEl.style.gridColumn = '1 / -1';
    noResultsEl.innerHTML = `
      <div class="w-16 h-16 rounded-full bg-amber-soft text-amber mx-auto flex items-center justify-center mb-4">
        <svg width="30" height="30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
      <h3 class="text-xl font-bold mb-2">No Articles Found</h3>
      <p class="text-secondary text-sm mb-5 max-w-md mx-auto">We couldn't find any security guides or tips matching your query. Try different keywords or reset your search.</p>
      <button type="button" id="blog-reset-filter-btn" class="btn btn-outline-amber btn-sm">Reset Search &amp; View All Articles</button>
    `;
    gridContainer.appendChild(noResultsEl);

    document.getElementById('blog-reset-filter-btn')?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (searchClearBtn) searchClearBtn.style.display = 'none';
      filterBtns.forEach(b => {
        if (b.getAttribute('data-filter') === 'all') {
          b.classList.add('active', 'btn-outline-amber');
          b.classList.remove('btn-secondary');
        } else {
          b.classList.remove('active', 'btn-outline-amber');
          b.classList.add('btn-secondary');
        }
      });
      filterBlog(false);
      if (searchInput) searchInput.focus();
    });
  }

  function filterBlog(isSearchAction = false) {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    if (searchClearBtn) {
      searchClearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
    }

    let activeBtn = document.querySelector('.js-blog-filter-btn.active');
    let category = activeBtn ? activeBtn.getAttribute('data-filter') : 'all';

    // If an explicit search was triggered and the currently active category produces 0 results,
    // automatically fall back to 'all' so users find articles across other categories
    if (isSearchAction && query && category !== 'all') {
      let matchesInCat = 0;
      blogCards.forEach(card => {
        const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
        const cardTitle = (card.querySelector('.blog-title')?.textContent || '').toLowerCase();
        const cardSnippet = (card.querySelector('.blog-snippet')?.textContent || '').toLowerCase();
        if (cardCategory.includes(category.toLowerCase())) {
          if (cardTitle.includes(query) || cardCategory.includes(query) || cardSnippet.includes(query)) {
            matchesInCat++;
          }
        }
      });
      if (matchesInCat === 0) {
        filterBtns.forEach(b => {
          if (b.getAttribute('data-filter') === 'all') {
            b.classList.add('active', 'btn-outline-amber');
            b.classList.remove('btn-secondary');
          } else {
            b.classList.remove('active', 'btn-outline-amber');
            b.classList.add('btn-secondary');
          }
        });
        category = 'all';
      }
    }

    let visibleCount = 0;

    blogCards.forEach(card => {
      const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
      const cardTitle = (card.querySelector('.blog-title')?.textContent || '').toLowerCase();
      const cardSnippet = (card.querySelector('.blog-snippet')?.textContent || '').toLowerCase();

      // Check rich article content from BLOG_ARTICLES database if available
      const cardLink = card.querySelector('a[href*="id="]')?.getAttribute('href') || '';
      const articleIdMatch = cardLink.match(/id=(\d+)/);
      let fullContent = '';
      if (articleIdMatch && typeof BLOG_ARTICLES !== 'undefined') {
        const art = BLOG_ARTICLES.find(a => a.id === parseInt(articleIdMatch[1], 10));
        if (art) fullContent = (art.content || '').replace(/<[^>]*>/g, ' ').toLowerCase();
      }

      const matchesCat = category === 'all' || cardCategory.includes(category.toLowerCase());
      const matchesQuery = !query ||
        cardTitle.includes(query) ||
        cardCategory.includes(query) ||
        cardSnippet.includes(query) ||
        fullContent.includes(query);

      if (matchesCat && matchesQuery) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResultsEl) {
      noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  // Pre-fill query or category if present in URL (e.g. blog.html?q=deadbolt or blog.html?category=Smart%20Tech)
  const urlParams = new URLSearchParams(window.location.search);
  const initialQ = urlParams.get('q') || urlParams.get('search');
  const initialCat = urlParams.get('category') || urlParams.get('cat');

  if (initialCat) {
    const targetCat = initialCat.toLowerCase().trim();
    filterBtns.forEach(btn => {
      const filterVal = (btn.getAttribute('data-filter') || '').toLowerCase().trim();
      if (filterVal === targetCat || filterVal.includes(targetCat) || targetCat.includes(filterVal)) {
        filterBtns.forEach(b => {
          b.classList.remove('active', 'btn-outline-amber');
          b.classList.add('btn-secondary');
        });
        btn.classList.add('active', 'btn-outline-amber');
        btn.classList.remove('btn-secondary');
      }
    });
  }

  if (initialQ && searchInput) {
    searchInput.value = initialQ;
    if (searchClearBtn) searchClearBtn.style.display = 'inline-flex';
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => filterBlog(false));
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        filterBlog(true);
      }
    });
  }

  if (searchForm) {
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      filterBlog(true);
    });
  }

  if (searchBtn) {
    searchBtn.addEventListener('click', (e) => {
      e.preventDefault();
      filterBlog(true);
    });
  }

  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchClearBtn.style.display = 'none';
      filterBlog(false);
      if (searchInput) searchInput.focus();
    });
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'btn-outline-amber');
        b.classList.add('btn-secondary');
      });
      btn.classList.add('active', 'btn-outline-amber');
      btn.classList.remove('btn-secondary');
      filterBlog(false);
    });
  });

  filterBlog(!!initialQ);
}
